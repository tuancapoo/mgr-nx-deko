+        "    adrp x2, g_rex_exc_dumped\n"
+        "    add  x2, x2, :lo12:g_rex_exc_dumped\n"
+        "    add  x2, x2, x7, lsl #10\n"
+        "    mov  x5, x2\n"
+        "    str  w0,  [x2], #4\n"
+        "    str  w7,  [x2], #4\n"
+        "    str  wzr, [x2], #4\n"
+        "    str  wzr, [x2], #4\n"
