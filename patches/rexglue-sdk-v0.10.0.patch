+        "    stp  x15, x16, [sp, #-16]!\n"
+        "    stp  x17, x18, [sp, #-16]!\n"
+        "    stp  x19, x20, [sp, #-16]!\n"
+        "    str  x21, [sp, #-16]!\n"
+        "    stp  x0,  x1,  [sp, #-16]!\n"
+        "    sub  sp, sp, #16\n"
+        "    mov  x0, sp\n"
+        "    mov  x1, #8\n"
+        "    mov  w2, wzr\n"
+        "    mov  x3, #0\n"
