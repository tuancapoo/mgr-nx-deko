+ * neither has any reason to block another thread that only wants to look at the table.
+ */
+void SaveRange(uint32_t id, uint64_t displacement, uint32_t request, const uint8_t* data,
+                  size_t bytes) {
+  if (!bytes) {
+    return;
+  }
