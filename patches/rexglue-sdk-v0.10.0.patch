+        "    mov  w6, w0\n"
+        "    ldr  x7, [sp], #16\n"
+        "    ldp  x0,  x1,  [sp], #16\n"
+        "    ldr  x21, [sp], #16\n"
+        "    ldp  x19, x20, [sp], #16\n"
+        "    ldp  x17, x18, [sp], #16\n"
+        "    ldp  x15, x16, [sp], #16\n"
+        "    ldp  x13, x14, [sp], #16\n"
+        "    ldp  x11, x12, [sp], #16\n"
+        "    ldp  x9,  x10, [sp], #16\n"
