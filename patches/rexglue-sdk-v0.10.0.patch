+      semaphore_->Release(1, nullptr);
+    }
+    if (in_queue < 2) {
+      semaphore_->Release(1, nullptr);
+    }
+    deadline += interval;
+    if (now >= deadline) {
+      deadline = now + interval;
+    }
+  }
