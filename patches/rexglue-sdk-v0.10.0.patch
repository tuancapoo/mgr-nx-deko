diff --git a/tests/arm_forms_check.cpp b/tests/arm_forms_check.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..89639f0c427b31b5f9a575367438b297ef10716b
--- /dev/null
+++ b/tests/arm_forms_check.cpp
@@ -0,0 +1,71 @@
+// Compile-only check for the Switch compiler (it cannot run on the PC): the AArch64-only forms of the CPU round of
+// 2026-10-12, one small function each, so tools/arm_forms_check.py can read the instructions GCC makes of them.
+//   - rex/thread/atomic.h: the inline __atomic lock words (exclusive pair with acquire/release, no trailing `dmb`
+//     outside the branch on g_rex_atomic_legacy_barrier), next to the legacy __sync forms they replace;
+//   - rex/ppc/intrinsics.h: vperm and the two float-to-integer conversions as their NEON instruction, with
+//     REX_VMX_HELPERS_X86_FORM the x86 emulation through simde;
+//   - rex/ppc/diet_ops.h: the any-mode float helpers compile (their PC test is sdk/tests/fp_any_mode_test.cpp).
+//
+//   python tools/arm_forms_check.py
+#include <cstdint>
+
+#include <rex/ppc/diet_ops.h>
+#include <rex/ppc/intrinsics.h>
+#include <rex/thread/atomic.h>
+
+#define CHECK_FN extern "C" __attribute__((noinline))
+
+CHECK_FN int32_t check_atomic_inc(volatile int32_t* p) { return rex::thread::atomic_inc(p); }
+CHECK_FN int32_t check_atomic_dec(volatile int32_t* p) { return rex::thread::atomic_dec(p); }
+CHECK_FN bool check_atomic_cas32(volatile int32_t* p) { return rex::thread::atomic_cas(int32_t(-1), int32_t(0), p); }
+CHECK_FN bool check_atomic_cas64(volatile int64_t* p, int64_t a, int64_t b) { return rex::thread::atomic_cas(a, b, p); }
+CHECK_FN int32_t check_atomic_exchange_add(volatile int32_t* p, int32_t n) {
+  return rex::thread::atomic_exchange_add(n, p);
+}
+
+// The legacy forms (what atomic_posix.cpp compiled before, and what the generator's stwcx. was).
+CHECK_FN int32_t check_legacy_inc(volatile int32_t* p) { return __sync_add_and_fetch(p, 1); }
+CHECK_FN bool check_legacy_cas32(volatile int32_t* p) { return __sync_bool_compare_and_swap(p, -1, 0); }
+
+CHECK_FN simde__m128i check_vperm(simde__m128i a, simde__m128i b, simde__m128i c) {
+  return rex::ppc::simde_mm_perm_epi8_(a, b, c);
+}
+CHECK_FN simde__m128i check_vctsxs(simde__m128 a) { return rex::ppc::simde_mm_vctsxs(a); }
+CHECK_FN simde__m128i check_vctuxs(simde__m128 a) { return rex::ppc::simde_mm_vctuxs(a); }
+
+CHECK_FN double check_add_single(double a, double b) { return rex::ppc::AddSingleAnyMode(a, b); }
+CHECK_FN double check_round_single(double a) { return rex::ppc::RoundToSingleAnyMode(a); }
+CHECK_FN bool check_ge_zero(double a) { return rex::ppc::GeZeroAnyMode(a); }
+
+// The second CPU round of 2026-10-12 (sa2-nx).
+//   - rex/ppc/diet_ops.h: fctid / fctiw as `frinti` + `fcvtzs`, fctidz as `fcvtzs` (codegen option fcti_inline; no
+//     call of round()); SingleToDoublePure and QuietSingleBits (fp_copy_pairs) without a call and without `msr`.
+//   - rex/ppc/intrinsics.h: the small VMX helpers as their NEON instruction.
+CHECK_FN int64_t check_fctid(double v) { return rex::ppc::fctid(v); }
+CHECK_FN int64_t check_fctiw(double v) { return rex::ppc::fctiw(v); }
+CHECK_FN int64_t check_fctidz(double v) { return rex::ppc::fctidz(v); }
+CHECK_FN double check_single_pure(uint32_t bits) { return rex::ppc::SingleToDoublePure(bits); }
+CHECK_FN uint32_t check_quiet_single(uint32_t bits) { return rex::ppc::QuietSingleBits(bits); }
+CHECK_FN simde__m128i check_adds_epu32(simde__m128i a, simde__m128i b) { return rex::ppc::simde_mm_adds_epu32(a, b); }
+CHECK_FN simde__m128i check_avg_epi8(simde__m128i a, simde__m128i b) { return rex::ppc::simde_mm_avg_epi8(a, b); }
+CHECK_FN simde__m128i check_avg_epi16(simde__m128i a, simde__m128i b) { return rex::ppc::simde_mm_avg_epi16(a, b); }
+CHECK_FN simde__m128i check_avg_epi32(simde__m128i a, simde__m128i b) { return rex::ppc::simde_mm_avg_epi32(a, b); }
+CHECK_FN simde__m128 check_cvtepu32_ps(simde__m128i a) { return rex::ppc::simde_mm_cvtepu32_ps_(a); }
+CHECK_FN simde__m128i check_cmpgt_epu8(simde__m128i a, simde__m128i b) { return rex::ppc::simde_mm_cmpgt_epu8(a, b); }
+CHECK_FN simde__m128i check_cmpgt_epu16(simde__m128i a, simde__m128i b) { return rex::ppc::simde_mm_cmpgt_epu16(a, b); }
+CHECK_FN simde__m128i check_sllv_epi16(simde__m128i a, simde__m128i c) { return rex::ppc::simde_mm_sllv_epi16(a, c); }
+CHECK_FN simde__m128i check_srlv_epi16(simde__m128i a, simde__m128i c) { return rex::ppc::simde_mm_srlv_epi16(a, c); }
+CHECK_FN simde__m128i check_srav_epi16(simde__m128i a, simde__m128i c) { return rex::ppc::simde_mm_srav_epi16(a, c); }
+CHECK_FN simde__m128i check_sllv_epi8(simde__m128i a, simde__m128i c) { return rex::ppc::simde_mm_sllv_epi8(a, c); }
+
+// The third CPU round (codegen option div_inline): the divisions as the instruction, without a branch, next to the
+// guarded C expressions they replace.
+CHECK_FN uint32_t check_divwu(uint32_t n, uint32_t d) { return rex::ppc::divwu(n, d); }
+CHECK_FN uint32_t check_divw(int32_t n, int32_t d) { return rex::ppc::divw(n, d); }
+CHECK_FN uint64_t check_divdu(uint64_t n, uint64_t d) { return rex::ppc::divdu(n, d); }
+CHECK_FN int64_t check_divd(int64_t n, int64_t d) { return rex::ppc::divd(n, d); }
+CHECK_FN uint32_t check_old_divwu(uint32_t n, uint32_t d) { return d ? n / d : 0; }
+CHECK_FN uint32_t check_old_divw(int32_t n, int32_t d) {
+  return uint32_t((d && !(n == INT32_MIN && d == -1)) ? n / d : 0);
+}
+CHECK_FN uint32_t check_divw_by_10(int32_t n) { return rex::ppc::divw(n, 10); }
diff --git a/tests/fcti_copy_test.cpp b/tests/fcti_copy_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a923797a50862af3aa7f7ac6f307cd68c9ef535f
--- /dev/null
+++ b/tests/fcti_copy_test.cpp
@@ -0,0 +1,285 @@
+// The helpers of the codegen options fcti_inline and fp_copy_pairs (rex/ppc/diet_ops.h), sa2-nx's second CPU round.
+//
+// 1. fctid / fctiw / fctidz against a model of the PowerPC instruction written with integer arithmetic only (the
+//    double is taken apart, rounded by the rule of the mode and saturated), in each of the four rounding modes:
+//    edge values (zeros, halves, the int32 and int64 limits and their neighbours, denormals, infinities, NaNs) and
+//    random bit patterns. The model is also the AArch64 form step by step: `frinti` (to an integral double in the
+//    current mode) and the saturating `fcvtzs`, with the NaN select. The old generated expressions are run next to
+//    them: on x86 they must agree everywhere except fctid / fctidz at exactly 2^63 (reported: once per mode).
+// 2. rex::ppc::SingleToDoublePure and QuietSingleBits for ALL 2^32 single bit patterns:
+//      - with the flush mode off: the same bits as `double(float)` and as `float(double(float))`, and as a
+//        conversion written with integer arithmetic only;
+//      - with the flush mode on: SingleToDoublePure still gives the integer conversion's bits (the plain conversion
+//        does not: its differences are counted as the negative control and must not be 0).
+//
+//   clang++ -O2 -std=c++23 -ffp-contract=off -Isdk/include -Isdk/thirdparty/simde -Isdk/thirdparty/simde/simde
+//           sdk/tests/fcti_copy_test.cpp -o out/tools/fcti_copy_test.exe
+//   fcti_copy_test [random values per mode = 20000000]
+#include <bit>
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#include <rex/ppc/diet_ops.h>
+#include <simde/x86/sse2.h>
+
+namespace {
+
+using P = rex::platform::FPSCRPlatform;
+
+#if defined(__aarch64__)
+#define OPAQUE(x) __asm__ __volatile__("" : "+w"(x))
+#else
+#define OPAQUE(x) __asm__ __volatile__("" : "+x"(x))
+#endif
+
+void SetFlush(bool on) {
+  auto csr = P::getcsr();
+  csr = on ? decltype(csr)(csr | decltype(csr)(P::FlushMask)) : decltype(csr)(csr & ~decltype(csr)(P::FlushMask));
+  P::setcsr(csr);
+}
+
+// Guest rounding modes (FPSCR.RN): 0 nearest even, 1 toward zero, 2 up, 3 down.
+void SetRounding(unsigned guest) {
+  auto csr = P::getcsr();
+  csr = decltype(csr)((csr & ~decltype(csr)(P::RoundMaskVal)) | decltype(csr)(P::GuestToHost[guest]));
+  P::setcsr(csr);
+}
+
+// The double rounded to an integer in the given mode, saturated to [lo, hi]; integer arithmetic only.
+// `nan` is the answer for a NaN.
+int64_t ModelRound(double v, unsigned mode, int64_t lo, int64_t hi, int64_t nan) {
+  const uint64_t bits = std::bit_cast<uint64_t>(v);
+  const bool negative = bits >> 63;
+  const int exponent = int((bits >> 52) & 0x7FF);
+  uint64_t fraction = bits & 0x000FFFFFFFFFFFFFull;
+  if (exponent == 0x7FF) {
+    if (fraction != 0) return nan;
+    return negative ? lo : hi;
+  }
+  // |v| = magnitude * 2^-shift exactly (as far as it matters), with the bits below the integer in `rest`.
+  unsigned __int128 magnitude;
+  bool half = false, below = false;  // the first bit below the integer, and any bit below that
+  if (exponent == 0) {
+    magnitude = 0;
+    below = fraction != 0;  // a denormal: less than a half
+  } else {
+    fraction |= 0x0010000000000000ull;
+    const int e = exponent - 1023 - 52;  // |v| = fraction * 2^e
+    if (e >= 0) {
+      if (e > 62) return negative ? lo : hi;  // at least 2^115
+      magnitude = (unsigned __int128)fraction << e;
+    } else if (e < -54) {
+      magnitude = 0;
+      below = true;
+    } else {
+      const int s = -e;  // 1..54
+      magnitude = s >= 64 ? 0 : fraction >> s;
+      half = (fraction >> (s - 1)) & 1;
+      below = (fraction & ((1ull << (s - 1)) - 1)) != 0;
+    }
+  }
+  bool up = false;  // away from zero
+  switch (mode) {
+    case 0: up = half && (below || (magnitude & 1)); break;
+    case 1: up = false; break;
+    case 2: up = !negative && (half || below); break;
+    case 3: up = negative && (half || below); break;
+  }
+  if (up) ++magnitude;
+  if (negative) {
+    if (magnitude > (unsigned __int128)(-(__int128)lo)) return lo;
+    return int64_t(-(__int128)magnitude);
+  }
+  if (magnitude > (unsigned __int128)hi) return hi;
+  return int64_t(magnitude);
+}
+
+// The register images the instructions leave.
+int64_t ModelFctid(double v, unsigned mode) { return ModelRound(v, mode, INT64_MIN, INT64_MAX, INT64_MIN); }
+int64_t ModelFctidz(double v) { return ModelRound(v, 1, INT64_MIN, INT64_MAX, INT64_MIN); }
+int64_t ModelFctiw(double v, unsigned mode) {
+  return ModelRound(v, mode, INT32_MIN, INT32_MAX, int64_t(0x80000000u));
+}
+
+[[gnu::noinline]] int64_t NewFctid(double v) { OPAQUE(v); return rex::ppc::fctid(v); }
+[[gnu::noinline]] int64_t NewFctidz(double v) { OPAQUE(v); return rex::ppc::fctidz(v); }
+[[gnu::noinline]] int64_t NewFctiw(double v) { OPAQUE(v); return rex::ppc::fctiw(v); }
+// The generator's expressions without the option (floating_point.cpp).
+[[gnu::noinline]] int64_t OldFctid(double v) {
+  OPAQUE(v);
+  return __builtin_isnan(v) ? int64_t(0x8000000000000000ULL)
+                            : (v > double(LLONG_MAX)) ? LLONG_MAX : simde_mm_cvtsd_si64(simde_mm_load_sd(&v));
+}
+[[gnu::noinline]] int64_t OldFctidz(double v) {
+  OPAQUE(v);
+  return __builtin_isnan(v) ? int64_t(0x8000000000000000ULL)
+                            : (v > double(LLONG_MAX)) ? LLONG_MAX : simde_mm_cvttsd_si64(simde_mm_load_sd(&v));
+}
+[[gnu::noinline]] int64_t OldFctiw(double v) {
+  OPAQUE(v);
+  return __builtin_isnan(v) ? int64_t(0x80000000U)
+                            : (v >= double(INT_MAX)) ? INT_MAX : simde_mm_cvtsd_si32(simde_mm_load_sd(&v));
+}
+
+uint64_t g_seed = 0x9E3779B97F4A7C15ull;
+uint64_t Next() {
+  g_seed ^= g_seed << 13;
+  g_seed ^= g_seed >> 7;
+  g_seed ^= g_seed << 17;
+  return g_seed;
+}
+
+// single -> double with integer arithmetic only, signalling NaNs quieted (what the hardware conversion does).
+uint64_t ModelSingleToDouble(uint32_t bits) {
+  const uint64_t sign = uint64_t(bits >> 31) << 63;
+  const uint32_t exponent = (bits >> 23) & 0xFF;
+  uint32_t fraction = bits & 0x007FFFFFu;
+  if (exponent == 0xFF) {
+    return sign | 0x7FF0000000000000ull | (fraction ? (uint64_t(fraction | 0x00400000u) << 29) : 0);
+  }
+  if (exponent == 0) {
+    if (fraction == 0) return sign;
+    int e = 1;
+    while (!(fraction & 0x00800000u)) {
+      fraction <<= 1;
+      --e;
+    }
+    return sign | (uint64_t(e - 127 + 1023) << 52) | (uint64_t(fraction & 0x007FFFFFu) << 29);
+  }
+  return sign | (uint64_t(exponent - 127 + 1023) << 52) | (uint64_t(fraction) << 29);
+}
+
+[[gnu::noinline]] uint64_t PlainLoad(uint32_t bits) {
+  float f = std::bit_cast<float>(bits);
+  OPAQUE(f);
+  double d = double(f);
+  OPAQUE(d);
+  return std::bit_cast<uint64_t>(d);
+}
+[[gnu::noinline]] uint32_t PlainCopy(uint32_t bits) {
+  float f = std::bit_cast<float>(bits);
+  OPAQUE(f);
+  double d = double(f);
+  OPAQUE(d);
+  float g = float(d);
+  OPAQUE(g);
+  return std::bit_cast<uint32_t>(g);
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  const uint64_t randoms = argc > 1 ? strtoull(argv[1], nullptr, 10) : 20000000ull;
+  uint64_t differences = 0, checked = 0, old_differs = 0;
+
+  // ---- 1. the conversions to integer ----
+  std::vector<double> edges;
+  const double base_values[] = {0.0, 0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 2.5, 3.5, 1e-310, 4.9406564584124654e-324,
+                                2147483645.5, 2147483646.0, 2147483646.5, 2147483647.0, 2147483647.25,
+                                2147483647.5, 2147483647.75, 2147483648.0, 2147483648.5, 2147483649.0, 4294967295.5,
+                                4294967296.0, 4503599627370495.5, 4503599627370496.0, 4503599627370497.0,
+                                9007199254740991.0, 9007199254740992.0, 9223372036854774784.0,
+                                9223372036854775808.0, 9223372036854777856.0, 1.8446744073709552e19, 1e300};
+  for (double v : base_values) {
+    edges.push_back(v);
+    edges.push_back(-v);
+    // the doubles next to it
+    const uint64_t b = std::bit_cast<uint64_t>(v);
+    edges.push_back(std::bit_cast<double>(b + 1));
+    edges.push_back(-std::bit_cast<double>(b + 1));
+    if (b) {
+      edges.push_back(std::bit_cast<double>(b - 1));
+      edges.push_back(-std::bit_cast<double>(b - 1));
+    }
+  }
+  for (uint64_t nan : {0x7FF0000000000000ull, 0xFFF0000000000000ull, 0x7FF8000000000000ull, 0xFFF8000000000001ull,
+                       0x7FF0000000000001ull, 0xFFF4000000000000ull}) {
+    edges.push_back(std::bit_cast<double>(nan));
+  }
+  SetFlush(false);
+  for (unsigned mode = 0; mode < 4; ++mode) {
+    SetRounding(mode);
+    const auto one = [&](double v) {
+      const int64_t d = NewFctid(v), dz = NewFctidz(v), w = NewFctiw(v);
+      const int64_t md = ModelFctid(v, mode), mdz = ModelFctidz(v), mw = ModelFctiw(v, mode);
+      checked += 3;
+      if (d != md || dz != mdz || w != mw) {
+        if (differences++ < 12) {
+          printf("DIFFERENCE mode %u v=%a: fctid %llx (model %llx) fctidz %llx (model %llx) fctiw %llx (model %llx)\n",
+                 mode, v, (unsigned long long)d, (unsigned long long)md, (unsigned long long)dz,
+                 (unsigned long long)mdz, (unsigned long long)w, (unsigned long long)mw);
+        }
+      }
+#if !defined(__aarch64__)
+      // The old expressions on x86: equal, except fctid / fctidz at exactly 2^63.
+      const bool at_limit = v == 9223372036854775808.0;
+      if (OldFctid(v) != d || OldFctidz(v) != dz || OldFctiw(v) != w) {
+        if (at_limit && OldFctiw(v) == w) {
+          ++old_differs;
+        } else if (differences++ < 12) {
+          printf("DIFFERENCE from the old expression, mode %u v=%a\n", mode, v);
+        }
+      }
+#endif
+    };
+    for (double v : edges) one(v);
+    for (uint64_t i = 0; i < randoms; ++i) {
+      uint64_t bits = Next();
+      switch (i & 3) {
+        case 0: break;                                                             // any double
+        case 1: bits = (bits & 0x800FFFFFFFFFFFFFull) | (uint64_t(1023 + (Next() % 70)) << 52); break;  // 1 .. 2^70
+        case 2: bits = std::bit_cast<uint64_t>(double(int64_t(Next() % 4000000) - 2000000) * 0.5); break;  // halves
+        case 3: bits = std::bit_cast<uint64_t>(2147483648.0 * ((Next() & 1) ? 1 : -1) +
+                                                 double(int64_t(Next() % 4096) - 2048) * 0.25); break;
+      }
+      one(std::bit_cast<double>(bits));
+    }
+  }
+  SetRounding(0);
+  printf("fcti: %llu results against the integer model in 4 rounding modes; old x86 expressions differ at 2^63 only: "
+         "%llu times\n",
+         (unsigned long long)checked, (unsigned long long)old_differs);
+
+  // ---- 2. the float copy pair, all single bit patterns ----
+  uint64_t control = 0;
+  SetFlush(false);
+  for (uint64_t i = 0; i <= 0xFFFFFFFFull; ++i) {
+    const uint32_t bits = uint32_t(i);
+    const uint64_t ref = PlainLoad(bits);
+    const uint64_t pure = std::bit_cast<uint64_t>(rex::ppc::SingleToDoublePure(bits));
+    if (pure != ref || ModelSingleToDouble(bits) != ref || rex::ppc::QuietSingleBits(bits) != PlainCopy(bits)) {
+      if (differences++ < 12) {
+        printf("DIFFERENCE (mode off) single %08x: pure %016llx model %016llx plain %016llx; quiet %08x plain %08x\n",
+               bits, (unsigned long long)pure, (unsigned long long)ModelSingleToDouble(bits),
+               (unsigned long long)ref, rex::ppc::QuietSingleBits(bits), PlainCopy(bits));
+      }
+    }
+  }
+  SetFlush(true);
+  for (uint64_t i = 0; i <= 0xFFFFFFFFull; ++i) {
+    const uint32_t bits = uint32_t(i);
+    const uint64_t model = ModelSingleToDouble(bits);
+    uint32_t opaque = bits;
+    __asm__ __volatile__("" : "+r"(opaque));
+    if (std::bit_cast<uint64_t>(rex::ppc::SingleToDoublePure(opaque)) != model) {
+      if (differences++ < 12) printf("DIFFERENCE (mode on) single %08x\n", bits);
+    }
+    if (PlainLoad(bits) != model) ++control;
+  }
+  const bool still_on = P::getcsr() & P::FlushMask;
+  SetFlush(false);
+  checked += 3 * 0x100000000ull + 0x100000000ull;
+  printf("copy pair: all 2^32 singles, mode off (pure, integer model, quieted bits) and mode on (pure); the plain "
+         "conversion differs with the mode on for %llu singles (negative control, must not be 0); mode left %s\n",
+         (unsigned long long)control, still_on ? "on (as set)" : "CHANGED");
+  if (!still_on) ++differences;
+  if (control == 0) {
+    printf("FAILED: the negative control found nothing\n");
+    return 2;
+  }
+  printf("%llu checks, %llu differences\n", (unsigned long long)checked, (unsigned long long)differences);
+  return differences ? 1 : 0;
+}
diff --git a/tests/float_loads_test.cpp b/tests/float_loads_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f2d2beecf8439bfe3505183f10f9cf10811a169c
--- /dev/null
+++ b/tests/float_loads_test.cpp
@@ -0,0 +1,57 @@
+// tools/float_loads.py: the AArch64 form of a single-precision guest load (the four big-endian bytes loaded into a
+// vector register and reversed there, `ldr s; rev32`) against the integer form it replaces (the word loaded,
+// byte-swapped and moved to the float register), for ALL 2^32 bit patterns. The NEON expression is the one the
+// generated pch defines (RexFloatFromBigEndian), run here through simde's model of the instructions; both forms only
+// move bytes, so every pattern (signalling NaNs and denormals included) must come out with the same bits.
+//
+//   clang++ -O2 -std=c++23 -march=x86-64-v2 -Isdk/include -Isdk/thirdparty/simde -Isdk/thirdparty/simde/simde
+//           sdk/tests/float_loads_test.cpp -o out/tools/float_loads_test.exe
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include <simde/arm/neon.h>
+
+namespace {
+
+// The pch's expression, with simde's names.
+inline float FromBigEndian(const void* p) noexcept {
+  float f;
+  std::memcpy(&f, p, 4);
+  const simde_float32x2_t v = simde_vset_lane_f32(f, simde_vdup_n_f32(0.0f), 0);
+  return simde_vget_lane_f32(simde_vreinterpret_f32_u8(simde_vrev32_u8(simde_vreinterpret_u8_f32(v))), 0);
+}
+
+// The integer form (REX_LOAD_U32 and the union read of the generated code).
+inline float IntegerForm(const void* p) noexcept {
+  uint32_t w;
+  std::memcpy(&w, p, 4);
+  return std::bit_cast<float>(__builtin_bswap32(w));
+}
+
+}  // namespace
+
+int main() {
+  uint64_t differences = 0;
+  alignas(8) unsigned char memory[8] = {};
+  for (uint64_t i = 0; i <= 0xFFFFFFFFull; ++i) {
+    const uint32_t guest = uint32_t(i);
+    // Guest memory holds the value big-endian.
+    memory[0] = uint8_t(guest >> 24);
+    memory[1] = uint8_t(guest >> 16);
+    memory[2] = uint8_t(guest >> 8);
+    memory[3] = uint8_t(guest);
+    void* p = memory;
+    __asm__ __volatile__("" : "+r"(p) : : "memory");
+    const uint32_t a = std::bit_cast<uint32_t>(FromBigEndian(p));
+    const uint32_t b = std::bit_cast<uint32_t>(IntegerForm(p));
+    if (a != b || b != guest) {
+      if (differences++ < 12) printf("DIFFERENCE %08x: vector form %08x integer form %08x\n", guest, a, b);
+    }
+  }
+  printf("float loads: all 2^32 patterns, vector form (simde's model) against the integer form\n");
+  printf("RESULT: %s (%llu differences)\n", differences ? "FAILED" : "ok", (unsigned long long)differences);
+  return differences ? 1 : 0;
+}
diff --git a/tests/fp_any_mode_test.cpp b/tests/fp_any_mode_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..17def57025403108bd06bc614b2caadb12cf9334
--- /dev/null
+++ b/tests/fp_any_mode_test.cpp
@@ -0,0 +1,274 @@
+// The any-mode helpers of the codegen option fp_compares_modeless (rex/ppc/diet_ops.h) against the plain operation:
+// for every input, the reference is the plain expression evaluated with the host flush mode OFF (what the generated
+// code did after switching to FPU mode), and the helper must give the same bits with the mode off AND with it on,
+// and leave the mode as it found it. Also the three conversions the option stops switching for at all (fcfid,
+// fctiwz, fctidz): their plain expressions must give the same bits in both modes.
+//
+// Inputs: every pair of a list of edge values (zeros, the smallest and largest denormal doubles, DBL_MIN, the single
+// denormal range and FLT_MIN seen as doubles, ones, huge values, infinities, quiet and signalling NaNs), then random
+// bit patterns with the exponent drawn from the edges half of the time.
+//
+//   clang++ -O2 -std=c++23 -ffp-contract=off -Isdk/include -Isdk/thirdparty/simde -Isdk/thirdparty/simde/simde
+//           sdk/tests/fp_any_mode_test.cpp -o out/tools/fp_any_mode_test.exe      (also builds for AArch64)
+//   fp_any_mode_test [random pairs = 20000000] [control]
+// "control" puts the plain operations in the helpers' place: the run must then report differences (it shows that the
+// inputs reach the cases where the mode matters).
+#include <bit>
+#include <climits>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#include <rex/ppc/diet_ops.h>
+#include <simde/x86/sse2.h>
+
+namespace {
+
+using P = rex::platform::FPSCRPlatform;
+
+// The flags of a CR field, as rex::ppc::CRRegister::compare(double, double) writes them.
+struct Cr {
+  bool lt, gt, eq, un;
+  void compare(double left, double right) noexcept {
+    un = __builtin_isunordered(left, right);
+    lt = __builtin_isless(left, right);
+    gt = __builtin_isgreater(left, right);
+    eq = left == right;
+  }
+  uint32_t bits() const { return uint32_t(lt) | uint32_t(gt) << 1 | uint32_t(eq) << 2 | uint32_t(un) << 3; }
+};
+
+#if defined(__aarch64__)
+#define OPAQUE(x) __asm__ __volatile__("" : "+w"(x))
+#else
+#define OPAQUE(x) __asm__ __volatile__("" : "+x"(x))
+#endif
+
+void SetFlush(bool on) {
+  auto csr = P::getcsr();
+  csr = on ? decltype(csr)(csr | decltype(csr)(P::FlushMask)) : decltype(csr)(csr & ~decltype(csr)(P::FlushMask));
+  P::setcsr(csr);
+}
+
+[[gnu::noinline]] uint32_t PlainCompare(double a, double b) {
+  OPAQUE(a);
+  OPAQUE(b);
+  Cr cr;
+  cr.compare(a, b);
+  return cr.bits();
+}
+[[gnu::noinline]] uint32_t AnyCompare(double a, double b) {
+  OPAQUE(a);
+  OPAQUE(b);
+  Cr cr;
+  rex::ppc::CompareAnyMode(cr, a, b);
+  return cr.bits();
+}
+[[gnu::noinline]] uint64_t PlainFrsp(double a) {
+  OPAQUE(a);
+  float f = float(a);
+  OPAQUE(f);
+  double d = double(f);
+  OPAQUE(d);
+  return std::bit_cast<uint64_t>(d);
+}
+[[gnu::noinline]] uint64_t AnyFrsp(double a) {
+  OPAQUE(a);
+  double d = rex::ppc::RoundToSingleAnyMode(a);
+  OPAQUE(d);
+  return std::bit_cast<uint64_t>(d);
+}
+[[gnu::noinline]] bool PlainGeZero(double a) {
+  OPAQUE(a);
+  return a >= 0.0;
+}
+[[gnu::noinline]] bool AnyGeZero(double a) {
+  OPAQUE(a);
+  return rex::ppc::GeZeroAnyMode(a);
+}
+// fadds / fsubs / fmuls / fdivs: the generator's plain expression and the any-mode helper (fp_mode_lookahead).
+#define ARITHMETIC(NAME, OP, HELPER)                         \
+  [[gnu::noinline]] uint64_t Plain##NAME(double a, double b) { \
+    OPAQUE(a);                                               \
+    OPAQUE(b);                                               \
+    double d = a OP b;                                       \
+    OPAQUE(d);                                               \
+    float f = float(d);                                      \
+    OPAQUE(f);                                               \
+    double r = double(f);                                    \
+    OPAQUE(r);                                               \
+    return std::bit_cast<uint64_t>(r);                       \
+  }                                                          \
+  [[gnu::noinline]] uint64_t Any##NAME(double a, double b) {   \
+    OPAQUE(a);                                               \
+    OPAQUE(b);                                               \
+    double r = rex::ppc::HELPER(a, b);                       \
+    OPAQUE(r);                                               \
+    return std::bit_cast<uint64_t>(r);                       \
+  }
+ARITHMETIC(Add, +, AddSingleAnyMode)
+ARITHMETIC(Sub, -, SubSingleAnyMode)
+ARITHMETIC(Mul, *, MulSingleAnyMode)
+ARITHMETIC(Div, /, DivSingleAnyMode)
+#undef ARITHMETIC
+
+// The generator's expressions for the conversions that no longer switch.
+[[gnu::noinline]] int64_t Fctiwz(double a) {
+  OPAQUE(a);
+  return rex::ppc::fctiwz(a);
+}
+[[gnu::noinline]] int64_t Fctidz(double a) {
+  OPAQUE(a);
+  return std::isnan(a) ? int64_t(0x8000000000000000ULL)
+                       : (a > double(LLONG_MAX)) ? LLONG_MAX : simde_mm_cvttsd_si64(simde_mm_load_sd(&a));
+}
+[[gnu::noinline]] uint64_t Fcfid(int64_t v) {
+  __asm__ __volatile__("" : "+r"(v));
+  double d = double(v);
+  OPAQUE(d);
+  return std::bit_cast<uint64_t>(d);
+}
+
+uint64_t g_state = 0x9E3779B97F4A7C15ull;
+uint64_t Next() {
+  g_state ^= g_state << 13;
+  g_state ^= g_state >> 7;
+  g_state ^= g_state << 17;
+  return g_state;
+}
+double RandomDouble() {
+  // Edges of the double and single ranges, and exponents whose products and quotients land on them (2^-511 squared
+  // is near DBL_MIN, 2^-63 squared near FLT_MIN, 2^-74 squared near the smallest single denormal).
+  static const uint64_t exponents[] = {0,     0,     1,     2,     3,     0x369, 0x36A, 0x380, 0x381, 0x382,
+                                       0x3FF, 0x47E, 0x47F, 0x7FE, 0x7FF, 0x1FF, 0x200, 0x201, 0x3BF, 0x3C0,
+                                       0x3C1, 0x3B4, 0x3B5, 0x43E, 0x43F, 0x5FE, 0x5FF};
+  uint64_t r = Next();
+  uint64_t e = (r >> 52) & 0x7FF;
+  if (Next() & 1) e = exponents[Next() % (sizeof(exponents) / sizeof(exponents[0]))];
+  uint64_t m = r & 0x000FFFFFFFFFFFFFull;
+  switch (Next() & 7) {  // mantissas at the rounding edges too
+    case 0: m = 0; break;
+    case 1: m = 0x000FFFFFFFFFFFFFull; break;
+    case 2: m &= 0x000FFFFFE0000000ull; break;  // exactly a single's mantissa
+    case 3: m = (m & 0x000FFFFFE0000000ull) | 0x10000000ull; break;  // a tie when rounded to single
+    default: break;
+  }
+  return std::bit_cast<double>((r & 0x8000000000000000ull) | (e << 52) | m);
+}
+
+uint64_t g_failures = 0, g_checks = 0, g_cold = 0;
+uint64_t g_mode_matters[4] = {};  // per arithmetic operation: inputs whose plain result differs between the modes
+bool g_control = false;  // negative control: the plain operations in the helpers' place must differ with the mode on
+void Fail(const char* what, bool mode, double a, double b, uint64_t got, uint64_t want) {
+  if (g_failures++ < 20) {
+    std::printf("FAILED %s (flush mode %s): a %016llX b %016llX got %llX want %llX\n", what, mode ? "on" : "off",
+                static_cast<unsigned long long>(std::bit_cast<uint64_t>(a)),
+                static_cast<unsigned long long>(std::bit_cast<uint64_t>(b)), static_cast<unsigned long long>(got),
+                static_cast<unsigned long long>(want));
+  }
+}
+
+void CheckPair(double a, double b) {
+  SetFlush(false);
+  const uint32_t want_cmp = PlainCompare(a, b);
+  const uint64_t want_frsp = PlainFrsp(a);
+  const bool want_ge = PlainGeZero(a);
+  const int64_t want_fctiwz = Fctiwz(a), want_fctidz = Fctidz(a);
+  const int64_t integer = std::bit_cast<int64_t>(a);
+  const uint64_t want_fcfid = Fcfid(integer);
+  if (rex::ppc::IsDenormalDouble(a) || rex::ppc::IsDenormalDouble(b)) ++g_cold;
+  const uint64_t want_arith[4] = {PlainAdd(a, b), PlainSub(a, b), PlainMul(a, b), PlainDiv(a, b)};
+  // NaN payloads: the operations return one of the operands' payloads either way; compared as "is a NaN".
+  const auto same = [](uint64_t x, uint64_t y) {
+    const bool nx = (x & 0x7FFFFFFFFFFFFFFFull) > 0x7FF0000000000000ull;
+    const bool ny = (y & 0x7FFFFFFFFFFFFFFFull) > 0x7FF0000000000000ull;
+    return nx || ny ? nx == ny : x == y;
+  };
+  for (const bool mode : {false, true}) {
+    SetFlush(mode);
+    const auto before = P::getcsr();
+    const uint32_t cmp = g_control ? PlainCompare(a, b) : AnyCompare(a, b);
+    const uint64_t frsp = g_control ? PlainFrsp(a) : AnyFrsp(a);
+    const bool ge = g_control ? PlainGeZero(a) : AnyGeZero(a);
+    const int64_t fctiwz = Fctiwz(a), fctidz = Fctidz(a);
+    const uint64_t fcfid = Fcfid(integer);
+    const uint64_t arith[4] = {g_control ? PlainAdd(a, b) : AnyAdd(a, b), g_control ? PlainSub(a, b) : AnySub(a, b),
+                               g_control ? PlainMul(a, b) : AnyMul(a, b), g_control ? PlainDiv(a, b) : AnyDiv(a, b)};
+    const auto after = P::getcsr();
+    static const char* const names[4] = {"AddSingleAnyMode", "SubSingleAnyMode", "MulSingleAnyMode",
+                                         "DivSingleAnyMode"};
+    for (int k = 0; k < 4; ++k) {
+      if (!same(arith[k], want_arith[k])) Fail(names[k], mode, a, b, arith[k], want_arith[k]);
+    }
+    if (mode) {
+      const uint64_t plain_on[4] = {PlainAdd(a, b), PlainSub(a, b), PlainMul(a, b), PlainDiv(a, b)};
+      for (int k = 0; k < 4; ++k) g_mode_matters[k] += !same(plain_on[k], want_arith[k]);
+    }
+    g_checks += 10;
+    if (cmp != want_cmp) Fail("CompareAnyMode", mode, a, b, cmp, want_cmp);
+    if (frsp != want_frsp) Fail("RoundToSingleAnyMode", mode, a, b, frsp, want_frsp);
+    if (ge != want_ge) Fail("GeZeroAnyMode", mode, a, b, ge, want_ge);
+    if (fctiwz != want_fctiwz) Fail("fctiwz", mode, a, b, uint64_t(fctiwz), uint64_t(want_fctiwz));
+    if (fctidz != want_fctidz) Fail("fctidz", mode, a, b, uint64_t(fctidz), uint64_t(want_fctidz));
+    if (fcfid != want_fcfid) Fail("fcfid", mode, a, b, fcfid, want_fcfid);
+    if ((before ^ after) & decltype(before)(P::FlushMask)) Fail("the mode was left changed", mode, a, b, after, before);
+  }
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  const uint64_t random_pairs = argc > 1 ? std::strtoull(argv[1], nullptr, 10) : 20000000ull;
+  g_control = argc > 2 && argv[2][0] == 'c';
+  const auto saved = P::getcsr();
+  std::vector<double> edges;
+  const uint64_t magnitudes[] = {
+      0x0000000000000000ull, 0x0000000000000001ull, 0x0000000000000002ull, 0x0008000000000000ull,
+      0x000FFFFFFFFFFFFFull, 0x0010000000000000ull, 0x0010000000000001ull,  // around DBL_MIN
+      0x36A0000000000000ull, 0x369FFFFFFFFFFFFFull, 0x36A0000000000001ull,  // around the smallest single denormal
+      0x3690000000000000ull, 0x3680000000000000ull,                          // half of it and below: rounds to 0 or it
+      0x380FFFFFFFFFFFFFull, 0x3810000000000000ull, 0x3810000000000001ull,  // around FLT_MIN
+      0x380FFFFFF0000000ull, 0x380FFFFFE0000000ull, 0x3800000000000000ull,  // single denormals as doubles
+      0x3FF0000000000000ull, 0x3FF0000010000000ull, 0x3FEFFFFFFFFFFFFFull,  // around 1, a rounding tie
+      0x41DFFFFFFFC00000ull, 0x41E0000000000000ull, 0x43E0000000000000ull,  // INT32_MAX, 2^31, 2^63
+      0x47EFFFFFE0000000ull, 0x47EFFFFFF0000000ull, 0x47F0000000000000ull,  // FLT_MAX and past it
+      0x7FEFFFFFFFFFFFFFull, 0x7FF0000000000000ull, 0x7FF8000000000000ull, 0x7FF0000000000001ull,
+      0x7FFFFFFFFFFFFFFFull};
+  for (const uint64_t m : magnitudes) {
+    edges.push_back(std::bit_cast<double>(m));
+    edges.push_back(std::bit_cast<double>(m | 0x8000000000000000ull));
+  }
+  for (const double a : edges)
+    for (const double b : edges) CheckPair(a, b);
+  for (uint64_t i = 0; i < random_pairs; ++i) {
+    const double a = RandomDouble();
+    double b = (i & 7) == 0 ? edges[Next() % edges.size()] : RandomDouble();
+    if ((i & 7) == 1) {
+      // A near-equal partner: sums and differences that cancel down to a tiny result.
+      const uint64_t bits = std::bit_cast<uint64_t>(a) ^ (Next() & 0xFFFF) ^ ((Next() & 1) << 63);
+      b = std::bit_cast<double>(bits);
+    }
+    CheckPair(a, b);
+  }
+  P::setcsr(saved);
+  std::printf("%llu edge pairs and %llu random pairs, %llu comparisons of a helper with the plain operation "
+              "(%llu pairs with a denormal operand: the cold paths)\n",
+              static_cast<unsigned long long>(edges.size() * edges.size()),
+              static_cast<unsigned long long>(random_pairs), static_cast<unsigned long long>(g_checks),
+              static_cast<unsigned long long>(g_cold));
+  std::printf("pairs whose plain single-precision result differs between the modes: add %llu, sub %llu, mul %llu, "
+              "div %llu\n",
+              static_cast<unsigned long long>(g_mode_matters[0]), static_cast<unsigned long long>(g_mode_matters[1]),
+              static_cast<unsigned long long>(g_mode_matters[2]), static_cast<unsigned long long>(g_mode_matters[3]));
+  if (g_control) {
+    std::printf("NEGATIVE CONTROL (plain operations with the mode on): %llu differences; the test can see the "
+                "mode: %s\n",
+                static_cast<unsigned long long>(g_failures), g_failures ? "yes" : "NO");
+    return g_failures ? 0 : 1;
+  }
+  std::printf(g_failures ? "RESULT: FAILED (%llu differences)\n" : "RESULT: ok (0 differences)\n",
+              static_cast<unsigned long long>(g_failures));
+  return g_failures ? 1 : 0;
+}
diff --git a/tests/neon_shuffles_test.cpp b/tests/neon_shuffles_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b2a264a2e6add9883e739589ce488f098e05e739
--- /dev/null
+++ b/tests/neon_shuffles_test.cpp
@@ -0,0 +1,111 @@
+// tools/pch_neon_shuffles.py redefines, on AArch64, simde_mm_shuffle_epi32(v, imm) and simde_mm_permute_ps(v, imm)
+// as SIMDE_SHUFFLE_VECTOR_ with the indices (imm & 3, (imm >> 2) & 3, (imm >> 4) & 3, (imm >> 6) & 3). sasrt-nx left
+// this one without a test (the index formula is simde's own for targets without a native shuffle); sa2-nx checks it
+// anyway: this compares that exact expression (the macro bodies below are the tool's, under other names) with the
+// real pshufd / shufps of the PC for every one of the 256 immediates, on position-marking and random vectors.
+//
+//   clang++ -O2 -std=c++23 -march=x86-64-v2 -Isdk/include -Isdk/thirdparty/simde -Isdk/thirdparty/simde/simde
+//           sdk/tests/neon_shuffles_test.cpp -o out/tools/neon_shuffles_test.exe
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include <emmintrin.h>
+#include <simde/x86/avx.h>
+
+#if !defined(SIMDE_SHUFFLE_VECTOR_)
+#error "SIMDE_SHUFFLE_VECTOR_ is not available with this compiler: the tool's block would not apply either"
+#endif
+
+// The tool's two definitions (tools/pch_neon_shuffles.py, BLOCK), renamed.
+#define rex_test_shuffle_epi32(a, imm8)                                                        \
+  (__extension__({                                                                             \
+    const simde__m128i_private rex_shuffle_a_ = simde__m128i_to_private(a);                    \
+    simde__m128i_from_private((simde__m128i_private){                                          \
+        .i32 = SIMDE_SHUFFLE_VECTOR_(32, 16, (rex_shuffle_a_).i32, (rex_shuffle_a_).i32,       \
+                                     ((imm8)) & 3, ((imm8) >> 2) & 3, ((imm8) >> 4) & 3,       \
+                                     ((imm8) >> 6) & 3)});                                     \
+  }))
+#define rex_test_permute_ps(a, imm8)                                                           \
+  (__extension__({                                                                             \
+    const simde__m128_private rex_permute_a_ = simde__m128_to_private(a);                      \
+    simde__m128_from_private((simde__m128_private){                                            \
+        .f32 = SIMDE_SHUFFLE_VECTOR_(32, 16, (rex_permute_a_).f32, (rex_permute_a_).f32,       \
+                                     ((imm8)) & 3, ((imm8) >> 2) & 3, ((imm8) >> 4) & 3,       \
+                                     ((imm8) >> 6) & 3)});                                     \
+  }))
+
+namespace {
+
+uint64_t g_state = 0x9E3779B97F4A7C15ull;
+uint64_t Next() {
+  g_state ^= g_state << 13;
+  g_state ^= g_state >> 7;
+  g_state ^= g_state << 17;
+  return g_state;
+}
+
+uint64_t g_comparisons = 0, g_differences = 0;
+
+void Compare(const __m128i& want, const simde__m128i& got, const char* what, int imm) {
+  ++g_comparisons;
+  if (std::memcmp(&want, &got, 16) != 0) {
+    if (g_differences++ < 8) std::printf("DIFFERENCE %s imm %d\n", what, imm);
+  }
+}
+
+// The immediate must be a constant expression: one instantiation per value.
+template <int Imm>
+void One(const uint32_t* words) {
+  const __m128i v = _mm_loadu_si128(reinterpret_cast<const __m128i*>(words));
+  simde__m128i sv;
+  std::memcpy(&sv, &v, 16);
+  Compare(_mm_shuffle_epi32(v, Imm), rex_test_shuffle_epi32(sv, Imm), "shuffle_epi32", Imm);
+  const __m128 f = _mm_castsi128_ps(v);
+  simde__m128 sf;
+  std::memcpy(&sf, &f, 16);
+  // vpermilps with an immediate is shufps of the vector with itself.
+  const __m128 want = _mm_shuffle_ps(f, f, Imm);
+  const simde__m128 got = rex_test_permute_ps(sf, Imm);
+  __m128i want_i;
+  simde__m128i got_i;
+  std::memcpy(&want_i, &want, 16);
+  std::memcpy(&got_i, &got, 16);
+  Compare(want_i, got_i, "permute_ps", Imm);
+}
+
+template <int... Imm>
+void Row(const uint32_t* words, int base) {
+  (void)base;
+  (One<Imm>(words), ...);
+}
+
+#define R4(n) n, n + 1, n + 2, n + 3
+#define R16(n) R4(n), R4(n + 4), R4(n + 8), R4(n + 12)
+#define R64(n) R16(n), R16(n + 16), R16(n + 32), R16(n + 48)
+
+void All(const uint32_t* words) {
+  Row<R64(0)>(words, 0);
+  Row<R64(64)>(words, 64);
+  Row<R64(128)>(words, 128);
+  Row<R64(192)>(words, 192);
+}
+
+}  // namespace
+
+int main() {
+  const uint32_t marks[4] = {0x03020100u, 0x13121110u, 0x23222120u, 0x33323130u};
+  All(marks);
+  for (int i = 0; i < 20000; ++i) {
+    uint32_t words[4];
+    for (uint32_t& w : words) w = uint32_t(Next() >> 16);
+    if ((i & 7) == 0) words[i & 3] = 0x7FC00001u;  // a NaN payload must travel as bits
+    if ((i & 7) == 1) words[i & 3] = 0x00000001u;  // and a denormal
+    All(words);
+  }
+  std::printf("%llu comparisons of the constant-permutation forms with pshufd / shufps (256 immediates)\n",
+              static_cast<unsigned long long>(g_comparisons));
+  std::printf("RESULT: %s (%llu differences)\n", g_differences ? "FAILED" : "ok",
+              static_cast<unsigned long long>(g_differences));
+  return g_differences ? 1 : 0;
+}
diff --git a/tests/rotate_word_test.cpp b/tests/rotate_word_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4b4b97f04ca1deb2c7cb599f0b5c039ce133ae8b
--- /dev/null
+++ b/tests/rotate_word_test.cpp
@@ -0,0 +1,84 @@
+// The generator option rotate_word_narrow: rlwinm / rlwnm / rlwimi with a mask that does not wrap (mb <= me) written
+// as a 32-bit rotate and a 32-bit mask. This compares that form with the form the generator wrote before (a 64-bit
+// rotate of the word duplicated into both halves, masked with the 64-bit mask), bit for bit on the whole 64-bit
+// register, for every shift 0..31 and every mask mb <= me, on edge values and random ones, with random upper halves
+// in the source register (the old form reads `rS.u32 | (rS.u64 << 32)`, which drops them) and, for rlwimi, in the
+// destination (whose upper half must be kept). The wrapping masks (mb > me) keep the old form in the generator; the
+// test also shows that they need it (the narrow form differs there).
+//
+//   clang++ -O2 -std=c++20 sdk/tests/rotate_word_test.cpp -o out/tools/rotate_word_test.exe
+#include <cstdint>
+#include <cstdio>
+
+namespace {
+
+// sdk/src/codegen/builders/helpers.h, compute_mask (PowerPC bit numbering: bit 0 is the most significant).
+uint64_t ComputeMask(uint32_t mstart, uint32_t mstop) {
+  mstart &= 0x3F;
+  mstop &= 0x3F;
+  const uint64_t value = (UINT64_MAX >> mstart) ^ ((mstop >= 63) ? 0 : UINT64_MAX >> (mstop + 1));
+  return mstart <= mstop ? value : ~value;
+}
+
+uint64_t g_state = 0x13198A2E03707344ull;
+uint64_t Next() {
+  g_state ^= g_state << 13;
+  g_state ^= g_state >> 7;
+  g_state ^= g_state << 17;
+  return g_state;
+}
+
+uint64_t Rotl64(uint64_t x, unsigned n) { return n ? (x << n) | (x >> (64 - n)) : x; }
+uint32_t Rotl32(uint32_t x, unsigned n) { return n ? (x << n) | (x >> (32 - n)) : x; }
+
+// The old forms.
+uint64_t OldRlwinm(uint64_t rs, unsigned sh, uint64_t mask) {
+  return Rotl64(uint32_t(rs) | (rs << 32), sh) & mask;
+}
+uint64_t OldRlwimi(uint64_t ra, uint64_t rs, unsigned sh, uint64_t mask) {
+  return (Rotl64(uint32_t(rs) | (rs << 32), sh) & mask) | (ra & ~mask);
+}
+// The narrow forms (what the generator writes with the option).
+uint64_t NewRlwinm(uint64_t rs, unsigned sh, uint64_t mask) {
+  return Rotl32(uint32_t(rs), sh) & uint32_t(mask);
+}
+uint64_t NewRlwimi(uint64_t ra, uint64_t rs, unsigned sh, uint64_t mask) {
+  return (Rotl32(uint32_t(rs), sh) & uint32_t(mask)) | (ra & ~mask);
+}
+
+}  // namespace
+
+int main() {
+  const uint64_t edges[] = {0, 1, 0x80000000ull, 0xFFFFFFFFull, 0x7FFFFFFFull, 0x55555555ull, 0xAAAAAAAAull,
+                            0x00010000ull, 0xFFFF0000ull, 0x0000FFFFull, 0x12345678ull, 0x80000001ull};
+  uint64_t checked = 0, failures = 0, wrapping_differ = 0, wrapping = 0;
+  for (unsigned sh = 0; sh < 32; ++sh) {
+    for (unsigned mb = 0; mb < 32; ++mb) {
+      for (unsigned me = 0; me < 32; ++me) {
+        const uint64_t mask = ComputeMask(mb + 32, me + 32);
+        for (int k = 0; k < 12 + 64; ++k) {
+          const uint64_t upper = Next() << 32;
+          const uint64_t rs = (k < 12 ? edges[k] : (Next() & 0xFFFFFFFFull)) | upper;
+          const uint64_t ra = Next();
+          if (mb <= me) {
+            if ((mask >> 32) != 0) ++failures;  // the premise: a mask that does not wrap lies in the low word
+            failures += OldRlwinm(rs, sh, mask) != NewRlwinm(rs, sh, mask);
+            failures += OldRlwimi(ra, rs, sh, mask) != NewRlwimi(ra, rs, sh, mask);
+            checked += 2;
+          } else {
+            ++wrapping;
+            wrapping_differ += OldRlwinm(rs, sh, mask) != NewRlwinm(rs, sh, mask);
+          }
+        }
+      }
+    }
+  }
+  std::printf("%llu comparisons of the narrow forms with the 64-bit forms (every shift, every mask mb <= me)\n",
+              static_cast<unsigned long long>(checked));
+  std::printf("wrapping masks (kept in the 64-bit form by the generator): the narrow form would differ in %llu of "
+              "%llu cases\n",
+              static_cast<unsigned long long>(wrapping_differ), static_cast<unsigned long long>(wrapping));
+  std::printf(failures ? "RESULT: FAILED (%llu differences)\n" : "RESULT: ok (0 differences)\n",
+              static_cast<unsigned long long>(failures));
+  return failures ? 1 : 0;
+}
diff --git a/tests/signal_skip_idle_test.cpp b/tests/signal_skip_idle_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..15dde6c3a7588d2c012a1f506106f6380a37d344
--- /dev/null
+++ b/tests/signal_skip_idle_test.cpp
@@ -0,0 +1,222 @@
+// Stress test of the protocol behind thread_signal_skip_idle (sdk/src/core/threading_posix.cpp, PosixConditionBase):
+// a signal whose condition has no blocked waiter skips the notify. The classes below repeat that file's Event and
+// Semaphore logic line for line (state under the mutex, waiters counted under the same mutex around the wait, the
+// waiter count read together with the state change, the notify after the unlock) so the protocol itself can be run
+// on a PC, where threading_posix.cpp is not built.
+//
+// Each test is a strict handshake: a lost wake-up leaves a thread blocked for ever, which the watchdog reports.
+//   clang++ -O2 -std=c++20 sdk/tests/signal_skip_idle_test.cpp -o out/tools/signal_skip_idle_test.exe
+//   signal_skip_idle_test [seconds=5]
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace {
+
+std::atomic<uint64_t> g_notified{0}, g_skipped{0};
+
+class ConditionBase {
+ public:
+  virtual ~ConditionBase() = default;
+  bool Wait(std::chrono::milliseconds timeout) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    bool executed;
+    if (signaled()) {
+      executed = true;
+    } else {
+      ++cond_waiters_;
+      executed = cond_.wait_for(lock, timeout, [this] { return signaled(); });
+      --cond_waiters_;
+    }
+    if (executed) post_execution();
+    return executed;
+  }
+
+ protected:
+  virtual bool signaled() const = 0;
+  virtual void post_execution() = 0;
+  void WakeWaiters(uint32_t waiters) {
+    if (waiters != 0) {
+      cond_.notify_all();
+      g_notified.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      g_skipped.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  std::condition_variable cond_;
+  std::mutex mutex_;
+  uint32_t cond_waiters_ = 0;
+};
+
+class Event : public ConditionBase {
+ public:
+  explicit Event(bool manual_reset) : manual_reset_(manual_reset) {}
+  void Signal() {
+    uint32_t waiters;
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      signal_ = true;
+      waiters = cond_waiters_;
+    }
+    WakeWaiters(waiters);
+  }
+  void Reset() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    signal_ = false;
+  }
+
+ private:
+  bool signaled() const override { return signal_; }
+  void post_execution() override {
+    if (!manual_reset_) signal_ = false;
+  }
+  bool signal_ = false;
+  const bool manual_reset_;
+};
+
+class Semaphore : public ConditionBase {
+ public:
+  void Release(uint32_t n) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    count_ += n;
+    const uint32_t waiters = cond_waiters_;
+    lock.unlock();
+    WakeWaiters(waiters);
+  }
+
+ private:
+  bool signaled() const override { return count_ > 0; }
+  void post_execution() override {
+    count_--;
+    WakeWaiters(cond_waiters_);
+  }
+  uint32_t count_ = 0;
+};
+
+constexpr auto kStuck = std::chrono::milliseconds(4000);
+std::atomic<bool> g_failed{false};
+
+void Fail(const char* what) {
+  if (!g_failed.exchange(true)) std::printf("FAILED: %s\n", what);
+}
+
+// Ping-pong on two auto-reset events: every Signal must wake exactly one Wait. Returns the round trips.
+uint64_t PingPong(std::chrono::steady_clock::time_point end, int spin) {
+  Event ping(false), pong(false);
+  std::atomic<bool> stop{false};
+  std::atomic<uint64_t> trips{0};
+  std::thread echo([&] {
+    while (!stop.load(std::memory_order_relaxed)) {
+      if (!ping.Wait(kStuck)) {
+        if (!stop.load()) Fail("auto-reset event: a signal woke nobody (echo side)");
+        return;
+      }
+      for (volatile int i = 0; i < spin; ++i) {}
+      pong.Signal();
+    }
+  });
+  while (std::chrono::steady_clock::now() < end && !g_failed.load()) {
+    ping.Signal();
+    if (!pong.Wait(kStuck)) {
+      Fail("auto-reset event: a signal woke nobody (caller side)");
+      break;
+    }
+    trips.fetch_add(1, std::memory_order_relaxed);
+  }
+  stop.store(true);
+  ping.Signal();
+  echo.join();
+  return trips.load();
+}
+
+// Producers release a semaphore, consumers take it: every unit released is consumed.
+uint64_t SemaphoreFlow(std::chrono::steady_clock::time_point end, int producers, int consumers) {
+  Semaphore sem;
+  std::atomic<uint64_t> produced{0}, consumed{0};
+  std::atomic<bool> stop{false};
+  std::vector<std::thread> threads;
+  for (int i = 0; i < consumers; ++i) {
+    threads.emplace_back([&] {
+      for (;;) {
+        if (sem.Wait(std::chrono::milliseconds(50))) {
+          consumed.fetch_add(1, std::memory_order_relaxed);
+        } else if (stop.load() && consumed.load() >= produced.load()) {
+          return;
+        }
+      }
+    });
+  }
+  for (int i = 0; i < producers; ++i) {
+    threads.emplace_back([&, i] {
+      uint32_t n = 0;
+      while (std::chrono::steady_clock::now() < end) {
+        produced.fetch_add(1, std::memory_order_relaxed);
+        sem.Release(1);
+        if ((++n & (i ? 63 : 7)) == 0) std::this_thread::yield();
+        // Never far ahead of the consumers: the test is about wake-ups, not about a queue growing.
+        while (produced.load(std::memory_order_relaxed) - consumed.load(std::memory_order_relaxed) > 64 &&
+               std::chrono::steady_clock::now() < end + kStuck) {
+          std::this_thread::yield();
+        }
+      }
+    });
+  }
+  for (int i = consumers; i < int(threads.size()); ++i) threads[size_t(i)].join();
+  stop.store(true);
+  const auto deadline = std::chrono::steady_clock::now() + kStuck;
+  while (consumed.load() < produced.load() && std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
+  if (consumed.load() != produced.load()) Fail("semaphore: released units were never consumed (a lost wake-up)");
+  for (int i = 0; i < consumers; ++i) threads[size_t(i)].join();
+  return consumed.load();
+}
+
+// A manual-reset event set once wakes every waiter, whether it blocked before or arrives after.
+uint64_t ManualBroadcast(std::chrono::steady_clock::time_point end) {
+  uint64_t rounds = 0;
+  while (std::chrono::steady_clock::now() < end && !g_failed.load()) {
+    Event gate(true);
+    std::atomic<int> through{0};
+    std::vector<std::thread> threads;
+    for (int i = 0; i < 4; ++i) {
+      threads.emplace_back([&, i] {
+        if (i & 1) std::this_thread::yield();
+        if (gate.Wait(kStuck)) through.fetch_add(1);
+      });
+    }
+    if (rounds & 1) std::this_thread::yield();
+    gate.Signal();
+    for (auto& t : threads) t.join();
+    if (through.load() != 4) Fail("manual-reset event: a waiter stayed blocked after the event was set");
+    ++rounds;
+  }
+  return rounds;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  const int seconds = argc > 1 ? std::atoi(argv[1]) : 5;
+  const auto slice = std::chrono::milliseconds(seconds * 1000 / 4);
+  auto end = std::chrono::steady_clock::now() + slice;
+  const uint64_t trips_tight = PingPong(end, 0);
+  end = std::chrono::steady_clock::now() + slice;
+  const uint64_t trips_spin = PingPong(end, 2000);
+  end = std::chrono::steady_clock::now() + slice;
+  const uint64_t units = SemaphoreFlow(end, 2, 3);
+  end = std::chrono::steady_clock::now() + slice;
+  const uint64_t rounds = ManualBroadcast(end);
+  std::printf("auto-reset ping-pong: %llu + %llu round trips; semaphore: %llu units through 2 producers and 3 "
+              "consumers; manual-reset broadcast: %llu rounds of 4 waiters\n",
+              static_cast<unsigned long long>(trips_tight), static_cast<unsigned long long>(trips_spin),
+              static_cast<unsigned long long>(units), static_cast<unsigned long long>(rounds));
+  std::printf("signals: %llu notified, %llu found nobody blocked and skipped the notify\n",
+              static_cast<unsigned long long>(g_notified.load()), static_cast<unsigned long long>(g_skipped.load()));
+  std::printf(g_failed.load() ? "RESULT: FAILED\n" : "RESULT: ok (no lost wake-up)\n");
+  return g_failed.load() ? 1 : 0;
+}
diff --git a/tests/vec_byteswap_test.cpp b/tests/vec_byteswap_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cd023085749b8da7d17dc201ff54ce6be0ae5ce8
--- /dev/null
+++ b/tests/vec_byteswap_test.cpp
@@ -0,0 +1,81 @@
+// tools/vec_byteswap.py replaces, on AArch64, the 16-byte reversal the generator writes as
+//     simde_mm_shuffle_epi8(v, simde_mm_load_si128((simde__m128i*)VectorMaskL))
+// with vextq_u8(r, r, 8), r = vrev64q_u8(v). This checks that the two are the same permutation, on a PC: the left
+// side with the real pshufb and the SDK's own mask table, the right side with simde's implementation of the two NEON
+// instructions (its model of their definition). Position-marking vectors (each byte its own index), single-byte
+// vectors and random ones.
+//
+//   clang++ -O2 -std=c++23 -march=x86-64-v2 -Isdk/include -Isdk/thirdparty/simde -Isdk/thirdparty/simde/simde
+//           -Iout/pc/rexglue-sdk/include sdk/tests/vec_byteswap_test.cpp -o out/tools/vec_byteswap_test.exe
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include <simde/arm/neon.h>
+#include <simde/x86/ssse3.h>
+
+#include <rex/ppc/intrinsics.h>
+
+namespace {
+
+uint64_t g_state = 0x243F6A8885A308D3ull;
+uint64_t Next() {
+  g_state ^= g_state << 13;
+  g_state ^= g_state >> 7;
+  g_state ^= g_state << 17;
+  return g_state;
+}
+
+bool Same(const uint8_t* bytes) {
+  simde__m128i v;
+  std::memcpy(&v, bytes, 16);
+  const simde__m128i table =
+      simde_mm_shuffle_epi8(v, simde_mm_load_si128(reinterpret_cast<const simde__m128i*>(rex::ppc::VectorMaskL)));
+  simde_uint8x16_t n = simde_vld1q_u8(bytes);
+  const simde_uint8x16_t r = simde_vrev64q_u8(n);
+  n = simde_vextq_u8(r, r, 8);
+  uint8_t a[16], b[16];
+  std::memcpy(a, &table, 16);
+  simde_vst1q_u8(b, n);
+  return std::memcmp(a, b, 16) == 0;
+}
+
+}  // namespace
+
+int main() {
+  uint64_t checked = 0, failures = 0;
+  uint8_t bytes[16];
+  for (int i = 0; i < 16; ++i) bytes[i] = uint8_t(i);
+  failures += !Same(bytes);
+  ++checked;
+  // The expected permutation itself, spelled out once: byte i of the result is byte 15 - i of the input.
+  {
+    simde__m128i v;
+    std::memcpy(&v, bytes, 16);
+    const simde__m128i table =
+        simde_mm_shuffle_epi8(v, simde_mm_load_si128(reinterpret_cast<const simde__m128i*>(rex::ppc::VectorMaskL)));
+    uint8_t out[16];
+    std::memcpy(out, &table, 16);
+    for (int i = 0; i < 16; ++i) failures += out[i] != uint8_t(15 - i);
+  }
+  for (int i = 0; i < 16; ++i) {
+    for (int value = 1; value < 256; ++value) {
+      std::memset(bytes, 0, 16);
+      bytes[i] = uint8_t(value);
+      failures += !Same(bytes);
+      ++checked;
+    }
+  }
+  for (int k = 0; k < 4000000; ++k) {
+    const uint64_t lo = Next(), hi = Next();
+    std::memcpy(bytes, &lo, 8);
+    std::memcpy(bytes + 8, &hi, 8);
+    failures += !Same(bytes);
+    ++checked;
+  }
+  std::printf("%llu vectors: REV64 + EXT #8 against pshufb with VectorMaskL's first row\n",
+              static_cast<unsigned long long>(checked));
+  std::printf(failures ? "RESULT: FAILED (%llu differences)\n" : "RESULT: ok (0 differences)\n",
+              static_cast<unsigned long long>(failures));
+  return failures ? 1 : 0;
+}
diff --git a/tests/vmx_helpers_neon_test.cpp b/tests/vmx_helpers_neon_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4bb6491d62e6adbcbab1499e523224f4ed2cdc89
--- /dev/null
+++ b/tests/vmx_helpers_neon_test.cpp
@@ -0,0 +1,147 @@
+// rex/ppc/intrinsics.h gives three VMX helper operations a NEON-native form on AArch64:
+//   simde_mm_perm_epi8_ (vperm)   -> vqtbl2q_u8({a, b}, (c & 0x1F) ^ 0x0F)
+//   simde_mm_vctsxs               -> vcvtq_s32_f32   (FCVTZS)
+//   simde_mm_vctuxs               -> vcvtq_u32_f32   (FCVTZU)
+// This runs on a PC: the left side is the header's x86 form (what the PC build executes), the right side the same
+// expression as the NEON path written with simde's implementation of the NEON instruction (its model of the
+// instruction's definition) for vperm, and for the two conversions a scalar statement of the Arm definition of
+// FCVTZS / FCVTZU. Every result must be equal.
+//
+//   clang++ -O2 -std=c++23 -march=x86-64-v2 -Isdk/include -Isdk/thirdparty/simde -Isdk/thirdparty/simde/simde
+//           -Iout/pc/rexglue-sdk/include sdk/tests/vmx_helpers_neon_test.cpp -o out/tools/vmx_helpers_neon_test.exe
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include <simde/arm/neon.h>
+
+#include <rex/ppc/intrinsics.h>
+
+namespace {
+
+uint64_t g_state = 0xA4093822299F31D0ull;
+uint64_t Next() {
+  g_state ^= g_state << 13;
+  g_state ^= g_state >> 7;
+  g_state ^= g_state << 17;
+  return g_state;
+}
+
+uint64_t g_checked = 0, g_failures = 0;
+
+// FCVTZS / FCVTZU of a single, as the Arm ARM defines them (FPToFixed with round-toward-zero: a NaN gives 0, a value
+// beyond the destination's range saturates). simde's x86 implementation of vcvtq_u32_f32 is not used: it goes through
+// the signed conversion and returns 0x80000000 for values from 2^31 up, which the instruction does not.
+int32_t Fcvtzs(float x) {
+  if (std::isnan(x)) return 0;
+  if (x >= 2147483648.0f) return INT32_MAX;
+  if (x <= -2147483648.0f) return INT32_MIN;
+  return int32_t(x);
+}
+uint32_t Fcvtzu(float x) {
+  if (std::isnan(x)) return 0;
+  if (x >= 4294967296.0f) return UINT32_MAX;
+  if (x <= 0.0f) return 0;
+  return uint32_t(x);
+}
+
+void Report(const char* what, const void* in, const void* got, const void* want) {
+  if (g_failures++ < 12) {
+    uint32_t i[4], g[4], w[4];
+    std::memcpy(i, in, 16);
+    std::memcpy(g, got, 16);
+    std::memcpy(w, want, 16);
+    std::printf("FAILED %s: in %08X %08X %08X %08X  neon form %08X %08X %08X %08X  x86 form %08X %08X %08X %08X\n",
+                what, i[0], i[1], i[2], i[3], g[0], g[1], g[2], g[3], w[0], w[1], w[2], w[3]);
+  }
+}
+
+void CheckPerm(const uint8_t* a, const uint8_t* b, const uint8_t* c) {
+  simde__m128i va, vb, vc;
+  std::memcpy(&va, a, 16);
+  std::memcpy(&vb, b, 16);
+  std::memcpy(&vc, c, 16);
+  const simde__m128i x86 = rex::ppc::simde_mm_perm_epi8_(va, vb, vc);
+  const simde_uint8x16x2_t table = {{simde_vld1q_u8(a), simde_vld1q_u8(b)}};
+  const simde_uint8x16_t index =
+      simde_veorq_u8(simde_vandq_u8(simde_vld1q_u8(c), simde_vdupq_n_u8(0x1F)), simde_vdupq_n_u8(0x0F));
+  uint8_t neon[16], want[16];
+  simde_vst1q_u8(neon, simde_vqtbl2q_u8(table, index));
+  std::memcpy(want, &x86, 16);
+  ++g_checked;
+  if (std::memcmp(neon, want, 16) != 0) Report("vperm", c, neon, want);
+}
+
+void CheckConversions(const float* f) {
+  simde__m128 v;
+  std::memcpy(&v, f, 16);
+  const simde__m128i s86 = rex::ppc::simde_mm_vctsxs(v);
+  const simde__m128i u86 = rex::ppc::simde_mm_vctuxs(v);
+  int32_t sn[4];
+  uint32_t un[4];
+  for (int i = 0; i < 4; ++i) {
+    sn[i] = Fcvtzs(f[i]);
+    un[i] = Fcvtzu(f[i]);
+  }
+  g_checked += 2;
+  if (std::memcmp(sn, &s86, 16) != 0) Report("vctsxs", f, sn, &s86);
+  if (std::memcmp(un, &u86, 16) != 0) Report("vctuxs", f, un, &u86);
+}
+
+}  // namespace
+
+int main() {
+  uint8_t a[16], b[16], c[16];
+  // vperm: marker tables (a holds 0..15, b holds 16..31), every control byte value in every position, then random.
+  for (int i = 0; i < 16; ++i) {
+    a[i] = uint8_t(i);
+    b[i] = uint8_t(16 + i);
+  }
+  for (int position = 0; position < 16; ++position) {
+    for (int value = 0; value < 256; ++value) {
+      for (int i = 0; i < 16; ++i) c[i] = uint8_t(Next());
+      c[position] = uint8_t(value);
+      CheckPerm(a, b, c);
+    }
+  }
+  for (int k = 0; k < 3000000; ++k) {
+    uint64_t r[6];
+    for (auto& x : r) x = Next();
+    std::memcpy(a, &r[0], 16);
+    std::memcpy(b, &r[2], 16);
+    std::memcpy(c, &r[4], 16);
+    CheckPerm(a, b, c);
+  }
+  // The conversions: edge values in every lane position, then random bit patterns (exponents near 2^31 and 2^32 half
+  // of the time).
+  const uint32_t edges[] = {
+      0x00000000, 0x80000000, 0x00000001, 0x80000001, 0x007FFFFF, 0x00800000, 0x3F000000, 0xBF000000,  // 0, denormals, 0.5
+      0x3F7FFFFF, 0x3F800000, 0xBF800000, 0x3FFFFFFF, 0x40000000, 0x4EFFFFFF, 0x4F000000, 0x4F000001,  // around 2^31
+      0xCEFFFFFF, 0xCF000000, 0xCF000001, 0x4F7FFFFF, 0x4F800000, 0x4F800001, 0xCF800000, 0x5F000000,  // around 2^32
+      0x7F7FFFFF, 0xFF7FFFFF, 0x7F800000, 0xFF800000, 0x7FC00000, 0xFFC00000, 0x7F800001, 0xFFBFFFFF,  // max, inf, NaNs
+      0x4B000000, 0x4B000001, 0xCB000001, 0x4A7FFFFE};                                                 // integers with halves
+  float f[4];
+  for (const uint32_t e0 : edges) {
+    for (const uint32_t e1 : edges) {
+      const uint32_t bits[4] = {e0, e1, uint32_t(Next()), e0 ^ 0x80000000u};
+      std::memcpy(f, bits, 16);
+      CheckConversions(f);
+    }
+  }
+  for (int k = 0; k < 8000000; ++k) {
+    uint32_t bits[4];
+    for (auto& x : bits) {
+      x = uint32_t(Next());
+      if (Next() & 1) x = (x & 0x807FFFFFu) | (uint32_t(0x9C + Next() % 8) << 23);  // exponents 2^29 .. 2^36
+    }
+    std::memcpy(f, bits, 16);
+    CheckConversions(f);
+  }
+  std::printf("%llu comparisons of the NEON forms with the x86 forms (vperm, vctsxs, vctuxs)\n",
+              static_cast<unsigned long long>(g_checked));
+  std::printf(g_failures ? "RESULT: FAILED (%llu differences)\n" : "RESULT: ok (0 differences)\n",
+              static_cast<unsigned long long>(g_failures));
+  return g_failures ? 1 : 0;
+}
diff --git a/tests/vmx_small_helpers_test.cpp b/tests/vmx_small_helpers_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ee2b94b7eb001d8f197b77f67859cf8df86d8e1f
--- /dev/null
+++ b/tests/vmx_small_helpers_test.cpp
@@ -0,0 +1,230 @@
+// The small VMX helper operations of rex/ppc/intrinsics.h against the NEON instruction each one stands for, on a PC:
+// the header's x86 form on one side, a scalar statement of the NEON instruction's definition on the other.
+//   simde_mm_cvtepu32_ps_  (vcfux)    UCVTF: unsigned 32-bit integer to single, round to nearest even
+//                                     -> ALL 2^32 inputs
+//   simde_mm_adds_epu32    (vadduws)  UQADD: unsigned saturating add
+//   simde_mm_cmpgt_epu8/16 (vcmpgtub/uh) CMHI: unsigned greater-than
+//   simde_mm_avg_epi8/16   (vavgsb/sh)   SRHADD: signed (a + b + 1) >> 1
+//   VectorMaskL / VectorMaskR: every byte is 0..15 or has bit 7 set (then pshufb and TBL agree on it)
+// sa2-nx (2026-10-12), with the NEON forms now in the header:
+//   simde_mm_avg_epi32     (vavgsw)   SRHADD on words
+//   simde_mm_sllv_epi16 / srlv_epi16 / srav_epi16 / sllv_epi8: USHL / SSHL with the count clamped. Each is compared
+//                                     with a scalar statement of what the x86 form gives for EVERY count (0 or the
+//                                     sign fill from the lane size on) and with the header's NEON expression run
+//                                     through simde's model of the instruction.
+// A helper is only given a NEON form in the header if this reports 0 differences for it.
+//
+//   clang++ -O2 -std=c++23 -march=x86-64-v2 -Isdk/include -Isdk/thirdparty/simde -Isdk/thirdparty/simde/simde
+//           -Iout/pc/rexglue-sdk/include sdk/tests/vmx_small_helpers_test.cpp -o out/tools/vmx_small_helpers_test.exe
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include <simde/arm/neon.h>
+
+#include <rex/ppc/intrinsics.h>
+
+namespace {
+
+uint64_t g_state = 0x452821E638D01377ull;
+uint64_t Next() {
+  g_state ^= g_state << 13;
+  g_state ^= g_state >> 7;
+  g_state ^= g_state << 17;
+  return g_state;
+}
+
+}  // namespace
+
+int main() {
+  // UCVTF, every input. The C conversion of a uint32_t to float is correctly rounded in the current mode (round to
+  // nearest even here): cvtsi2ss from the zero-extended 64-bit value.
+  uint64_t ucvtf_differences = 0;
+  uint32_t first_bad = 0;
+  for (uint64_t base = 0; base < 0x100000000ull; base += 4) {
+    const uint32_t in[4] = {uint32_t(base), uint32_t(base + 1), uint32_t(base + 2), uint32_t(base + 3)};
+    simde__m128i v;
+    std::memcpy(&v, in, 16);
+    const simde__m128 r = rex::ppc::simde_mm_cvtepu32_ps_(v);
+    float out[4];
+    std::memcpy(out, &r, 16);
+    for (int i = 0; i < 4; ++i) {
+      volatile uint32_t x = in[i];
+      const float want = float(uint32_t(x));
+      if (std::bit_cast<uint32_t>(out[i]) != std::bit_cast<uint32_t>(want)) {
+        if (!ucvtf_differences) first_bad = in[i];
+        ++ucvtf_differences;
+      }
+    }
+  }
+  std::printf("vcfux / UCVTF: all 4294967296 inputs, %llu differences%s\n",
+              static_cast<unsigned long long>(ucvtf_differences), ucvtf_differences ? " (first below)" : "");
+  if (ucvtf_differences) std::printf("  first differing input %08X\n", first_bad);
+
+  uint64_t add = 0, gt8 = 0, gt16 = 0, avg8 = 0, avg16 = 0, checked = 0;
+  for (int k = 0; k < 6000000; ++k) {
+    uint8_t a[16], b[16];
+    uint64_t r[4] = {Next(), Next(), Next(), Next()};
+    std::memcpy(a, &r[0], 16);
+    std::memcpy(b, &r[2], 16);
+    if ((k & 7) == 0) std::memset(a, (k & 8) ? 0xFF : 0x80, 16);
+    if ((k & 15) == 1) std::memcpy(b, a, 16);
+    simde__m128i va, vb;
+    std::memcpy(&va, a, 16);
+    std::memcpy(&vb, b, 16);
+    uint8_t out[16];
+    simde__m128i x = rex::ppc::simde_mm_adds_epu32(va, vb);
+    std::memcpy(out, &x, 16);
+    for (int i = 0; i < 4; ++i) {
+      uint32_t p, q, got;
+      std::memcpy(&p, a + 4 * i, 4);
+      std::memcpy(&q, b + 4 * i, 4);
+      std::memcpy(&got, out + 4 * i, 4);
+      const uint64_t sum = uint64_t(p) + q;
+      add += got != (sum > 0xFFFFFFFFull ? 0xFFFFFFFFu : uint32_t(sum));
+    }
+    x = rex::ppc::simde_mm_cmpgt_epu8(va, vb);
+    std::memcpy(out, &x, 16);
+    for (int i = 0; i < 16; ++i) gt8 += out[i] != (a[i] > b[i] ? 0xFF : 0x00);
+    x = rex::ppc::simde_mm_cmpgt_epu16(va, vb);
+    std::memcpy(out, &x, 16);
+    for (int i = 0; i < 8; ++i) {
+      uint16_t p, q, got;
+      std::memcpy(&p, a + 2 * i, 2);
+      std::memcpy(&q, b + 2 * i, 2);
+      std::memcpy(&got, out + 2 * i, 2);
+      gt16 += got != (p > q ? 0xFFFF : 0x0000);
+    }
+    x = rex::ppc::simde_mm_avg_epi8(va, vb);
+    std::memcpy(out, &x, 16);
+    for (int i = 0; i < 16; ++i) avg8 += int8_t(out[i]) != int8_t((int(int8_t(a[i])) + int(int8_t(b[i])) + 1) >> 1);
+    x = rex::ppc::simde_mm_avg_epi16(va, vb);
+    std::memcpy(out, &x, 16);
+    for (int i = 0; i < 8; ++i) {
+      int16_t p, q, got;
+      std::memcpy(&p, a + 2 * i, 2);
+      std::memcpy(&q, b + 2 * i, 2);
+      std::memcpy(&got, out + 2 * i, 2);
+      avg16 += got != int16_t((int(p) + int(q) + 1) >> 1);
+    }
+    ++checked;
+  }
+  std::printf("%llu random vector pairs: UQADD (vadduws) %llu differences, CMHI bytes %llu, CMHI halfwords %llu, "
+              "SRHADD bytes %llu, SRHADD halfwords %llu\n",
+              static_cast<unsigned long long>(checked), static_cast<unsigned long long>(add),
+              static_cast<unsigned long long>(gt8), static_cast<unsigned long long>(gt16),
+              static_cast<unsigned long long>(avg8), static_cast<unsigned long long>(avg16));
+
+  // The signed word average and the per-lane shifts. Counts: every small value, the lane sizes and their
+  // neighbours, values whose low byte alone would mislead USHL (256, 0x8000, 0xFF10), and random ones.
+  uint64_t avg32 = 0, sl16 = 0, sr16 = 0, sa16 = 0, sl8 = 0, shift_model = 0, shifts = 0;
+  static const uint16_t kCounts[] = {0, 1, 2, 7, 8, 9, 14, 15, 16, 17, 31, 32, 33, 127, 128, 129, 255, 256, 257,
+                                     0x7FFF, 0x8000, 0x8001, 0xFF00, 0xFF10, 0xFFFF};
+  for (int k = 0; k < 3000000; ++k) {
+    uint8_t a[16], c[16];
+    uint64_t r[4] = {Next(), Next(), Next(), Next()};
+    std::memcpy(a, &r[0], 16);
+    std::memcpy(c, &r[2], 16);
+    if ((k & 3) != 3) {
+      // Mostly edge counts: random ones are almost always "too large".
+      for (int i = 0; i < 8; ++i) {
+        const uint16_t n = kCounts[(Next() >> 20) % (sizeof(kCounts) / sizeof(kCounts[0]))];
+        std::memcpy(c + 2 * i, &n, 2);
+      }
+      if ((k & 3) == 1) {
+        for (int i = 0; i < 16; ++i) c[i] = uint8_t(kCounts[(Next() >> 20) % 21]);  // byte counts 0..255
+      }
+    }
+    simde__m128i va, vc;
+    std::memcpy(&va, a, 16);
+    std::memcpy(&vc, c, 16);
+    uint8_t out[16], model[16];
+    simde__m128i x = rex::ppc::simde_mm_avg_epi32(va, vc);
+    std::memcpy(out, &x, 16);
+    for (int i = 0; i < 4; ++i) {
+      int32_t p, q, got;
+      std::memcpy(&p, a + 4 * i, 4);
+      std::memcpy(&q, c + 4 * i, 4);
+      std::memcpy(&got, out + 4 * i, 4);
+      avg32 += got != int32_t((int64_t(p) + int64_t(q) + 1) >> 1);
+    }
+    const simde_uint16x8_t na = simde_vreinterpretq_u16_u8(simde_vld1q_u8(a));
+    const simde_uint16x8_t nc = simde_vreinterpretq_u16_u8(simde_vld1q_u8(c));
+    // sllv_epi16
+    x = rex::ppc::simde_mm_sllv_epi16(va, vc);
+    std::memcpy(out, &x, 16);
+    simde_vst1q_u8(model, simde_vreinterpretq_u8_u16(simde_vshlq_u16(
+                              na, simde_vreinterpretq_s16_u16(simde_vminq_u16(nc, simde_vdupq_n_u16(16))))));
+    shift_model += std::memcmp(out, model, 16) != 0;
+    for (int i = 0; i < 8; ++i) {
+      uint16_t p, n, got;
+      std::memcpy(&p, a + 2 * i, 2);
+      std::memcpy(&n, c + 2 * i, 2);
+      std::memcpy(&got, out + 2 * i, 2);
+      sl16 += got != (n >= 16 ? 0 : uint16_t(p << n));
+    }
+    // srlv_epi16
+    x = rex::ppc::simde_mm_srlv_epi16(va, vc);
+    std::memcpy(out, &x, 16);
+    simde_vst1q_u8(model, simde_vreinterpretq_u8_u16(simde_vshlq_u16(
+                              na, simde_vnegq_s16(simde_vreinterpretq_s16_u16(
+                                      simde_vminq_u16(nc, simde_vdupq_n_u16(16)))))));
+    shift_model += std::memcmp(out, model, 16) != 0;
+    for (int i = 0; i < 8; ++i) {
+      uint16_t p, n, got;
+      std::memcpy(&p, a + 2 * i, 2);
+      std::memcpy(&n, c + 2 * i, 2);
+      std::memcpy(&got, out + 2 * i, 2);
+      sr16 += got != (n >= 16 ? 0 : uint16_t(p >> n));
+    }
+    // srav_epi16
+    x = rex::ppc::simde_mm_srav_epi16(va, vc);
+    std::memcpy(out, &x, 16);
+    simde_vst1q_u8(model, simde_vreinterpretq_u8_s16(simde_vshlq_s16(
+                              simde_vreinterpretq_s16_u16(na),
+                              simde_vnegq_s16(simde_vreinterpretq_s16_u16(
+                                  simde_vminq_u16(nc, simde_vdupq_n_u16(15)))))));
+    shift_model += std::memcmp(out, model, 16) != 0;
+    for (int i = 0; i < 8; ++i) {
+      int16_t p, got;
+      uint16_t n;
+      std::memcpy(&p, a + 2 * i, 2);
+      std::memcpy(&n, c + 2 * i, 2);
+      std::memcpy(&got, out + 2 * i, 2);
+      sa16 += got != int16_t(p >> (n >= 15 ? 15 : n));
+    }
+    // sllv_epi8
+    x = rex::ppc::simde_mm_sllv_epi8(va, vc);
+    std::memcpy(out, &x, 16);
+    simde_vst1q_u8(model, simde_vshlq_u8(simde_vld1q_u8(a),
+                                         simde_vreinterpretq_s8_u8(simde_vminq_u8(simde_vld1q_u8(c),
+                                                                                  simde_vdupq_n_u8(8)))));
+    shift_model += std::memcmp(out, model, 16) != 0;
+    for (int i = 0; i < 16; ++i) sl8 += out[i] != (c[i] >= 8 ? 0 : uint8_t(a[i] << c[i]));
+    ++shifts;
+  }
+  std::printf("%llu random vector pairs: SRHADD words (vavgsw) %llu differences; shifts against the scalar statement: "
+              "sllv16 %llu, srlv16 %llu, srav16 %llu, sllv8 %llu; against the NEON expression (simde's model): %llu\n",
+              static_cast<unsigned long long>(shifts), static_cast<unsigned long long>(avg32),
+              static_cast<unsigned long long>(sl16), static_cast<unsigned long long>(sr16),
+              static_cast<unsigned long long>(sa16), static_cast<unsigned long long>(sl8),
+              static_cast<unsigned long long>(shift_model));
+
+  uint64_t mask_bytes = 0, mask_bad = 0;
+  for (const uint8_t byte : rex::ppc::VectorMaskL) {
+    ++mask_bytes;
+    mask_bad += !(byte <= 15 || (byte & 0x80));
+  }
+  for (const uint8_t byte : rex::ppc::VectorMaskR) {
+    ++mask_bytes;
+    mask_bad += !(byte <= 15 || (byte & 0x80));
+  }
+  std::printf("VectorMaskL / VectorMaskR: %llu bytes, %llu outside {0..15, bit 7 set}\n",
+              static_cast<unsigned long long>(mask_bytes), static_cast<unsigned long long>(mask_bad));
+  const bool ok = !ucvtf_differences && !add && !gt8 && !gt16 && !avg8 && !avg16 && !mask_bad && !avg32 && !sl16 &&
+                  !sr16 && !sa16 && !sl8 && !shift_model;
+  std::printf(ok ? "RESULT: ok (0 differences)\n" : "RESULT: differences found (see above)\n");
+  return ok ? 0 : 1;
+}
