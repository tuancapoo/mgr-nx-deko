+void VulkanPresenter::SealRefreshesAndWait() {
+  if (!refreshes_no_seal_.exchange(false, std::memory_order_relaxed)) {
+    // Nothing is unsealed: either there has been no refresh since the last seal, or lazy sealing is
+    // off and every refresh already carried its own fence.
+    return;
+  }
+  /*
+   * It is the same empty submission as always, but paid only here. The queue is unique (Maxwell: NVK
+   * only exposes one graphics queue), so its fence covers everything submitted earlier in submission
+   * order, refreshes included:
+   * "Fence signal operations that are defined by vkQueueSubmit additionally include in the first
+   *  synchronization scope all commands that occur earlier in submission order."
+   * The queue lock is released before waiting on the fence: waiting with the lock held would block
+   * the painting thread for no reason.
+   */
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  uint64_t profile = PaintedNow();
+  {
+    VulkanSubmissionTracker::FenceAcquisition fence_acqusition(
+        guest_output_image_refresher_submission_tracker_.AcquireFenceToAdvanceSubmission());
+    {
+      const VulkanDevice::Queue::Acquisition queue_acquisition =
+          vulkan_device_->AcquireQueue(vulkan_device_->queue_family_graphics_compute(), 0);
+      profile = PaintedSpan(kChunkRefreshPadlock, profile);
+      if (dfn.vkQueueSubmit(queue_acquisition.queue(), 0, nullptr, fence_acqusition.fence()) !=
+          VK_SUCCESS) {
+        // Same as before: the refresh commands will still run, but this fence stays
+        // unsignaled and there is nothing to wait for. It is reported because here it is
+        // not a per-frame case but the seal that protects the image destruction.
+        REXLOG_ERROR("VulkanPresenter: Failed to submit the guest output refresh sealing fence");
+        fence_acqusition.SubmissionSucceededSignalFailed();
+      }
+    }
+    PaintedSpan(kChunkRefreshSend, profile);
+  }
+  // Now outside the fence scope, which on closing left it in the tracker's pending list with this
+  // submission's index: AwaitAll waits for exactly that one.
+  guest_output_image_refresher_submission_tracker_.AwaitAllSubmissionsCompletion();
+}
