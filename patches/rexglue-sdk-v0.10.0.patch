+namespace {
+std::atomic<uint64_t> g_hits{0};
+std::atomic<uint64_t> g_filled{0};
+std::atomic<uint64_t> g_direct{0};
+std::atomic<uint64_t> g_bytes_ram{0};
+std::atomic<int64_t> g_live_windows{0};
