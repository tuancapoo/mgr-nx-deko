+bool InGuestWindow(uint64_t addr) {
+  const uint8_t* base = RexGmBase();
+  if (!base) {
+    return false;
+  }
+  const uint64_t b = reinterpret_cast<uint64_t>(base);
+  return addr >= b && addr < b + RexGmSize();
+}
