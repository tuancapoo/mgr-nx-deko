+  if (last_report_output.time_since_epoch().count() != 0) {
+    REXAPU_INFO("[audio] SDL in 10 s: {} frames with data and {} of silence from missing frames",
+                frames_with_data, frames_of_silence);
+  }
+  frames_with_data = 0;
+  frames_of_silence = 0;
+  last_report_output = now;
