diff --git a/config_switch_aarch64.h b/config_switch_aarch64.h
new file mode 100644
index 0000000000000000000000000000000000000000..c2a507ccff96ad072bb4c971bbd21448ddc94592
--- /dev/null
+++ b/config_switch_aarch64.h
@@ -0,0 +1,16 @@
+/* FFmpeg configuration for Nintendo Switch (Horizon, aarch64, devkitA64).
+ *
+ * The Xenia FFmpeg fork ships one config header per desktop/mobile OS and none
+ * for Horizon. Linux/aarch64 is the closest: same CPU features (NEON, ARMv8,
+ * inline assembly) and pthreads, which libnx provides. Only what Horizon lacks
+ * is turned off. Verified by compiling every libavutil and libavcodec source
+ * the SDK builds (NEON .S files included) with devkitA64. */
+#pragma once
+#include "config_linux_aarch64.h"
+
+#undef HAVE_SCHED_GETAFFINITY
+#define HAVE_SCHED_GETAFFINITY 0
+#undef HAVE_MMAP
+#define HAVE_MMAP 0
+#undef HAVE_SYSCONF
+#define HAVE_SYSCONF 0
diff --git a/libavcodec/fft_template.c b/libavcodec/fft_template.c
index 69f0a64de4289e39594015d31797ab0d559656ca..ba3de5a70b165898b0c34d6e172c06700f69f209 100644
--- a/libavcodec/fft_template.c
+++ b/libavcodec/fft_template.c
@@ -292,8 +292,47 @@ av_cold int ff_fft_init(FFTContext *s, int nbits, int inverse)
     }\
 } while(0);
 
-    if (s->revtab)
-        SPLIT_RADIX_PERMUTATION()
+    /*
+     * Fork addition: the permutation table only depends on (nbits, inverse,
+     * fft_permutation) and comes out identical every time. The XMA decoder
+     * reopens the codec on every new sound (XmaContext::ResetDecoderState), and
+     * in a collision there are many at once: on the console, MDCT initialization
+     * and split_radix_permutation were ~28 % of the XMA thread in the slow
+     * stretches. It is computed once per configuration and copied afterwards:
+     * same values, same audio.
+     */
+    if (s->revtab) {
+        static AVMutex masseffect_revtab_lock = AV_MUTEX_INITIALIZER;
+        static struct { int nbits, inverse, perm; uint16_t *tab; } masseffect_revtab_cache[16];
+        static int masseffect_revtab_n = 0;
+        uint16_t *cached = NULL;
+        ff_mutex_lock(&masseffect_revtab_lock);
+        for (i = 0; i < masseffect_revtab_n; i++) {
+            if (masseffect_revtab_cache[i].nbits == nbits &&
+                masseffect_revtab_cache[i].inverse == s->inverse &&
+                masseffect_revtab_cache[i].perm == s->fft_permutation) {
+                cached = masseffect_revtab_cache[i].tab;
+                break;
+            }
+        }
+        if (cached) {
+            memcpy(s->revtab, cached, n * sizeof(uint16_t));
+        } else {
+            SPLIT_RADIX_PERMUTATION()
+            if (masseffect_revtab_n < 16) {
+                uint16_t *copy = malloc(n * sizeof(uint16_t));
+                if (copy) {
+                    memcpy(copy, s->revtab, n * sizeof(uint16_t));
+                    masseffect_revtab_cache[masseffect_revtab_n].nbits = nbits;
+                    masseffect_revtab_cache[masseffect_revtab_n].inverse = s->inverse;
+                    masseffect_revtab_cache[masseffect_revtab_n].perm = s->fft_permutation;
+                    masseffect_revtab_cache[masseffect_revtab_n].tab = copy;
+                    masseffect_revtab_n++;
+                }
+            }
+        }
+        ff_mutex_unlock(&masseffect_revtab_lock);
+    }
     if (s->revtab32)
         SPLIT_RADIX_PERMUTATION(32)
 
